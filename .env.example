# ===== Supabase (ฐานข้อมูลจริง) =====
# หาได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ใช้เฉพาะฝั่ง server (เช่น API route / cron job) ห้ามเปิดเผยฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# สลับโหมดข้อมูล: "mock" = ใช้ข้อมูลจำลองในเครื่อง (ค่าเริ่มต้น, ใช้ตอน dev/demo)
#                  "supabase" = ต่อฐานข้อมูลจริง
NEXT_PUBLIC_DATA_MODE=mock

# ===== LINE Messaging API (เตรียมไว้สำหรับอนาคต ยังไม่ได้ต่อจริง) =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_NOTIFY_GROUP_ID=

# ===== Email แจ้งเตือน (เตรียมไว้สำหรับอนาคต ยังไม่ได้ต่อจริง) =====
NOTIFY_EMAIL_FROM=
RESEND_API_KEY=
